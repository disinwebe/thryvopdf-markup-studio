{
  "name": "plan-markup-studio",
  "productName": "ThryvoPDF Markup Studio",
  "version": "1.0.0",
  "description": "Windows PDF markup, measurement, compare and drawing-set app (Bluebeam-style)",
  "main": "electron/main.cjs",
  "author": "ThryvoPDF Markup Studio",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/embed-license-key.cjs",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "manual:pdf": "node scripts/generate-user-manual.cjs",
    "test": "vitest run",
    "server": "node server/server.cjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:server-manager": "node scripts/build-server-manager.cjs"
  },
  "build": {
    "appId": "com.planmarkupstudio.app",
    "productName": "ThryvoPDF Markup Studio",
    "publish": null,
    "files": ["dist/**", "electron/**", "assets/icon.*", "assets/menu/*.png", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": { "installerIcon": "assets/icon.ico", "uninstallerIcon": "assets/icon.ico", "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
